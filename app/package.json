{
  "name": "evertale-audiobook-player",
  "version": "1.8.0-beta.1",
  "description": "EverTale Audiobook Player for Windows",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "dev": "electron . --hearth-dev",
    "build:dir": "electron-builder --win dir",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check updater.cjs && node --check ai-transcription.cjs && node --check transcript-reader.js"
  },
  "dependencies": {
    "music-metadata": "^10.9.0",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-reloader": "^1.2.3"
  },
  "build": {
    "appId": "com.hearth.audiobooks",
    "productName": "EverTale Audiobook Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "ai-transcription.cjs",
      "transcript-reader.js",
      "updater.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json",
      "apply_patch.py",
      "Apply Update.cmd"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "EverTale-Audiobook-Player-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "draffey19-cmd",
        "repo": "evertale-audiobook-player",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": []
  }
}
